<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weekly Payment Wizard Form View -->
    <record id="view_weekly_payment_wizard_form" model="ir.ui.view">
        <field name="name">weekly.payment.wizard.form</field>
        <field name="model">weekly.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Weekly Payments">
                <group>
                    <group>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                    </group>
                </group>
                <separator string="Unpaid Agreements"/>
                <field name="agreement_line_ids">
                    <tree editable="bottom">
                        <field name="agreement_id" readonly="1"/>
                        <field name="total_value" readonly="1" widget="monetary"/>
                        <field name="total_paid" readonly="1" widget="monetary"/>
                        <field name="balance" readonly="1" widget="monetary"/>
                        <field name="payment_amount" widget="monetary"/>
                    </tree>
                </field>
                <footer>
                    <button string="Create Payments" name="action_create_payments" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Weekly Payment Wizard Action -->
    <record id="action_weekly_payment_wizard" model="ir.actions.act_window">
        <field name="name">Weekly Payments</field>
        <field name="res_model">weekly.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_subcontractor_agreement"/>
    </record>
</odoo>
