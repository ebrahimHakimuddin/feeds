<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Subcontractor Partners -->
        <record id="demo_partner_subcontractor_1" model="res.partner">
            <field name="name">ABC Subcontractors Ltd.</field>
            <field name="is_company">True</field>
            <field name="email">contact@abcsubcontractors.com</field>
            <field name="phone">+1-555-0101</field>
        </record>

        <record id="demo_partner_subcontractor_2" model="res.partner">
            <field name="name">XYZ Manufacturing Co.</field>
            <field name="is_company">True</field>
            <field name="email">info@xyzmanufacturing.com</field>
            <field name="phone">+1-555-0202</field>
        </record>

        <!-- Demo Products (if needed for testing) -->
        <!-- These are examples, actual product creation depends on product variants setup -->
        
        <!-- Demo Subcontractor Agreement 1 -->
        <record id="demo_agreement_1" model="subcontractor.agreement">
            <field name="name">AGR/DEMO/001</field>
            <field name="partner_id" ref="demo_partner_subcontractor_1"/>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.now() + timedelta(days=60)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="notes">Demo agreement for testing purposes</field>
        </record>

        <!-- Demo Subcontractor Agreement 2 -->
        <record id="demo_agreement_2" model="subcontractor.agreement">
            <field name="name">AGR/DEMO/002</field>
            <field name="partner_id" ref="demo_partner_subcontractor_2"/>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.now() + timedelta(days=75)).strftime('%Y-%m-%d')"/>
            <field name="state">draft</field>
            <field name="notes">Demo agreement 2 - in draft state</field>
        </record>

        <!-- Note: Demo items and payments would require existing products in the system -->
        <!-- They can be added manually during testing or via a separate demo data file -->
        <!-- that includes product creation -->

    </data>
</odoo>
