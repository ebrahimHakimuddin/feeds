<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subcontractor Payment Tree View -->
    <record id="view_subcontractor_payment_tree" model="ir.ui.view">
        <field name="name">subcontractor.payment.tree</field>
        <field name="model">subcontractor.payment</field>
        <field name="arch" type="xml">
            <tree string="Subcontractor Payments" decoration-success="state=='confirmed'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="agreement_id"/>
                <field name="payment_date"/>
                <field name="amount" sum="Total Payments"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Subcontractor Payment Form View -->
    <record id="view_subcontractor_payment_form" model="ir.ui.view">
        <field name="name">subcontractor.payment.form</field>
        <field name="model">subcontractor.payment</field>
        <field name="arch" type="xml">
            <form string="Subcontractor Payment">
                <header>
                    <button name="action_confirm" string="Confirm Payment" type="object" states="draft" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" states="draft,confirmed"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" states="cancelled"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="agreement_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subcontractor Payment Action -->
    <record id="action_subcontractor_payment" model="ir.actions.act_window">
        <field name="name">Subcontractor Payments</field>
        <field name="res_model">subcontractor.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Subcontractor Payment
            </p>
            <p>
                Record payments made to subcontractors for their agreements.
            </p>
        </field>
    </record>
</odoo>
