<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subcontractor Agreement List View -->
    <record id="view_subcontractor_agreement_tree" model="ir.ui.view">
        <field name="name">subcontractor.agreement.tree</field>
        <field name="model">subcontractor.agreement</field>
        <field name="arch" type="xml">
            <list string="Subcontractor Agreements" decoration-success="state=='active'" decoration-muted="state in ['cancelled', 'completed']">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="total_value" sum="Total Value"/>
                <field name="total_paid" sum="Total Paid"/>
                <field name="balance" sum="Balance"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Subcontractor Agreement Form View -->
    <record id="view_subcontractor_agreement_form" model="ir.ui.view">
        <field name="name">subcontractor.agreement.form</field>
        <field name="model">subcontractor.agreement</field>
        <field name="arch" type="xml">
            <form string="Subcontractor Agreement">
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_complete" string="Complete" type="object" invisible="state != 'active'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'active')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="total_value" widget="monetary"/>
                            <field name="total_paid" widget="monetary"/>
                            <field name="balance" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" context="{'subcontractor_item_view': True, 'default_detailed_type': 'product'}"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price"/>
                                    <field name="total_price"/>
                                    <field name="quantity_to_add"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="payment_date"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Subcontractor Agreement Action -->
    <record id="action_subcontractor_agreement" model="ir.actions.act_window">
        <field name="name">Subcontractor Agreements</field>
        <field name="res_model">subcontractor.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Subcontractor Agreement
            </p>
            <p>
                Create agreements with subcontractors to track items and payments.
            </p>
        </field>
    </record>
</odoo>
